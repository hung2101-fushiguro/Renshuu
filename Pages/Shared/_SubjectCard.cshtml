@model SubjectSummary
<article class="card subject-card library-item" data-search="@Model.Name">
    <div class="subject-card-top"><span class="subject-icon"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#book" /></svg></span><span class="badge badge-muted">@Model.QuestionCount câu hỏi</span></div>
    <h3>@Model.Name</h3>
    @if (Model.WrongCount > 0)
    { <p class="subject-status"><span class="status-dot needs-review" aria-hidden="true"></span>@Model.WrongCount câu cần ôn lại</p> }
    else
    { <p class="subject-status"><span class="status-dot" aria-hidden="true"></span>Sẵn sàng cho bài luyện tập</p> }
    <div class="subject-card-actions"><a class="subject-select" asp-page="/Index" asp-route-subjectId="@Model.Id" asp-fragment="practice">Luyện môn này<svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow" /></svg></a>@if (Model.WrongCount > 0) { <a asp-page="/Wrong/Index" asp-route-subjectId="@Model.Id" class="subject-wrong-link">Xem câu sai</a> }</div>
</article>
