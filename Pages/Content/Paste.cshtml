@page
@model TracNghiemWeb.Pages.Content.PasteModel
@{
    ViewData["Title"] = "Dán tài liệu";
    ViewData["Active"] = "content";
    ViewData["ContentTab"] = "paste";
}

<div class="page-head">
    <div>
        <h1>Dán tài liệu</h1>
        <p>Dán câu hỏi · xem trước rồi lưu. Nội dung mặc định chỉ tài khoản của bạn nhìn thấy.</p>
    </div>
</div>

<partial name="_ContentNav" />

<form method="post" asp-page-handler="Preview">
    <div asp-validation-summary="All"></div>

    <div class="card">
        <div class="form-grid">
            <div class="form-row-2">
                <div class="field">
                    <label asp-for="SubjectId">Môn học có sẵn</label>
                    <select asp-for="SubjectId" class="input">
                        <partial name="_SubjectOptions" model="SubjectOptionsView.From(Model.Subjects, Model.SubjectId)" />
                    </select>
                </div>

                <div class="field">
                    <label asp-for="NewSubjectName">Hoặc tạo môn mới</label>
                    <input asp-for="NewSubjectName" class="input" maxlength="200"
                           placeholder="Ví dụ: JLPT N3 — Tuần 1" />
                    <span class="hint">Nhập tên môn mới để tạo môn từ tài liệu này. Để trống để dùng môn đã chọn.</span>
                    <span asp-validation-for="NewSubjectName" class="field-error"></span>
                </div>
            </div>

            <div class="field">
                <label asp-for="Text">Nội dung câu hỏi</label>
                <textarea asp-for="Text" class="input" rows="14" spellcheck="false"
                          placeholder="Ví dụ:&#10;Câu hỏi đầu tiên?&#10;A. Đáp án A&#10;B. Đáp án B&#10;C. Đáp án C&#10;D. Đáp án D&#10;Đáp án: B&#10;Giải thích: Vì...&#10;&#10;Câu hỏi thứ hai?&#10;..."></textarea>
                <details class="help-disclosure"><summary>Cách nhập câu hỏi</summary><div class="help-content hint">
                    Mỗi câu gồm: dòng câu hỏi, 4 dòng đáp án (A. B. C. D. hoặc 1. 2. 3. 4.),
                    dòng "Đáp án: X" và dòng "Giải thích: ..." (không bắt buộc). Các câu cách nhau bằng dòng trống.
                    Có thể dùng &lt;u&gt;...&lt;/u&gt; để gạch chân, &lt;star&gt;&lt;/star&gt; cho ngôi sao,
                    &lt;blank&gt;&lt;/blank&gt; cho chỗ trống.
                </div></details>
            </div>
        </div>
    </div>

    <div class="page-head actions">
        <button type="submit" class="btn btn-primary">Xem trước</button>
    </div>
</form>

@if (Model.Preview is not null)
{
    <h2>Kết quả xem trước</h2>
    <partial name="_ImportPreview" model="Model.Preview" />

    <form method="post" asp-page-handler="Save">
        <button type="submit" class="btn btn-accent" disabled="@(Model.Preview.ValidCount == 0)">Lưu @Model.Preview.ValidCount câu hợp lệ</button>
    </form>
}
