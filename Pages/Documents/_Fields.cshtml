@model TracNghiemWeb.Pages.Documents.DocumentFieldsView
<div class="field"><label asp-for="Input.Title">Tên tài liệu</label><input asp-for="Input.Title" class="input" maxlength="200" required /><span asp-validation-for="Input.Title" class="field-error"></span></div>
<div class="field"><label asp-for="Input.SubjectId">Môn học <span class="label-unit">(tùy chọn)</span></label><select asp-for="Input.SubjectId" class="input"><option value="">Chưa phân loại</option>@foreach (var subject in Model.Subjects) { <option value="@subject.Id">@subject.Name</option> }</select><span asp-validation-for="Input.SubjectId" class="field-error"></span></div>
<div class="field"><label asp-for="Input.Description">Ghi chú <span class="label-unit">(tùy chọn)</span></label><textarea asp-for="Input.Description" class="input document-notes" rows="3" maxlength="1000" placeholder="Một vài ghi chú để dễ tìm lại"></textarea><span asp-validation-for="Input.Description" class="field-error"></span></div>
