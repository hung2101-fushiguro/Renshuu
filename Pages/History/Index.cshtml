@page
@model TracNghiemWeb.Pages.History.IndexModel
@{
    ViewData["Title"] = "Lịch sử làm bài";
    ViewData["Active"] = "history";
}
<div class="page-head">
    <h1>Lịch sử làm bài</h1>
    @if (Model.Attempts.Count > 0)
    {
        <div class="actions">
            <a asp-page="/History/Analytics" class="btn btn-secondary">
                <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chart" /></svg>
                Xem phân tích tiến độ
            </a>
            <form method="post" asp-page-handler="Clear" class="inline-form"
                  onsubmit="return confirm('Xóa toàn bộ lịch sử làm bài? Hành động này không thể hoàn tác.');">
                <button type="submit" class="btn btn-quiet">Xóa lịch sử</button>
            </form>
        </div>
    }
</div>

<nav class="subnav mb-lg" aria-label="Điều hướng lịch sử">
    <a asp-page="/History/Index" class="active" aria-current="page">
        <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#history" /></svg>
        Danh sách bài làm
    </a>
    <a asp-page="/History/Analytics">
        <svg class="icon" aria-hidden="true"><use href="/images/icons.svg#chart" /></svg>
        Thống kê &amp; Phân tích
    </a>
</nav>
@if (Model.Attempts.Count == 0)
{
    <div class="empty">
        <strong>Chưa có bài làm nào.</strong>
        <p>Hoàn thành bài đầu tiên để xem kết quả.</p>
        <a class="btn btn-primary" asp-page="/Index">Bắt đầu luyện tập</a>
    </div>
}
else
{
    <dl class="history-summary" aria-label="Thống kê các bài trong danh sách">
        <div><dt>Bài đã nộp</dt><dd>@Model.Attempts.Count</dd></div>
        <div><dt>Môn đã học</dt><dd>@Model.Attempts.Select(a => a.SubjectId).Distinct().Count()</dd></div>
        <div><dt>Cao nhất</dt><dd>@Display.Percentage(Model.Attempts.Max(a => a.Percentage))</dd></div>
        <div><dt>Câu đã làm</dt><dd>@Model.Attempts.Sum(a => a.TotalQuestions)</dd></div>
    </dl>
    <div class="history-list-heading"><h2>Bài gần đây</h2><span>Tối đa 100 bài</span></div>
    <ol class="history-list" role="list" aria-label="Bài đã nộp, mới nhất trước">
        @foreach (var attempt in Model.Attempts)
        {
            <li class="history-row">
                <div class="history-course">
                    <strong>@attempt.Subject?.Name</strong>
                    <time datetime="@attempt.SubmittedAt?.ToString("o")">@attempt.SubmittedAt?.ToString("dd/MM/yyyy · HH:mm")</time>
                </div>
                <div class="history-result">
                    <span class="visually-hidden">Kết quả:</span><strong>@attempt.CorrectCount/@attempt.TotalQuestions</strong>
                    <span>@Display.Percentage(attempt.Percentage) đúng</span>
                </div>
                <div class="history-duration"><span>Thời gian</span><strong>@Display.Duration(attempt.Duration)</strong></div>
                <div class="history-actions">
                    <a class="btn btn-quiet" asp-page="/Test/Result" asp-route-id="@attempt.Id">Xem lại<svg class="icon" aria-hidden="true"><use href="/images/icons.svg#arrow" /></svg></a>
                    <form method="post" asp-page-handler="Delete" class="inline-form" onsubmit="return confirm('Xóa bài làm này?');">
                        <input type="hidden" name="id" value="@attempt.Id" />
                        <button type="submit" class="btn btn-quiet" aria-label="Xóa bài @attempt.Subject?.Name, nộp @attempt.SubmittedAt?.ToString("dd/MM HH:mm")">Xóa</button>
                    </form>
                </div>
            </li>
        }
    </ol>
}
@section Styles { <link rel="stylesheet" href="~/css/history.css" asp-append-version="true" /> }
