@page "{id:int}"
@model TracNghiemWeb.Pages.Test.TakeModel
@{
    ViewData["Title"] = Model.IsPractice ? "Ôn tập" : "Làm bài";
}

<div class="quiz-bar">
    <div class="quiz-meta">
        <span class="badge badge-primary">@Model.SubjectName</span>
        <span class="badge badge-muted">@(Model.IsPractice ? "Ôn tập" : "Làm bài")</span>
        @if (Model.TimeLimitMinutes is int limit)
        {
            <span class="timer" id="timer" data-limit="@limit">
                <svg class="icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 6v6l4 2" />
                </svg>
                <span id="timer-text">--:--</span>
            </span>
            <span class="visually-hidden">Thời gian còn lại</span>
        }
        else
        {
            <span class="small">Không giới hạn thời gian</span>
        }
    </div>

    <div class="quiz-meta">
        <span id="progress-text" aria-live="polite">0/@Model.Questions.Count câu</span>
        @if (Model.IsPractice)
        {
            <button type="button" id="toggle-answers" class="btn btn-secondary"
                    aria-pressed="false" aria-controls="quiz-form" aria-keyshortcuts="S" hidden>Hiện đáp án (S)</button>
        }
        <button type="submit" form="quiz-form" class="btn btn-accent">Nộp bài</button>
    </div>

    <div class="progress" role="progressbar" aria-label="Tiến độ trả lời" aria-valuemin="0" aria-valuemax="@Model.Questions.Count" aria-valuenow="0" id="progress">
        <span id="progress-bar"></span>
    </div>
</div>

<form method="post" id="quiz-form"
      data-attempt-id="@Model.AttemptId"
      data-started-at="@Model.StartedAt.ToString("o")"
      data-total="@Model.Questions.Count">
    <input type="hidden" name="id" value="@Model.AttemptId" />

    @{
        var questionNumber = 0;
    }
    @foreach (var group in Model.Groups)
    {
        if (group.Passage is not null)
        {
            <section class="passage-card">
                @if (!string.IsNullOrWhiteSpace(group.Passage.Title))
                {
                    <h2 class="passage-title">@group.Passage.Title</h2>
                }
                <div class="passage-content">@Display.RichText(group.Passage.Content)</div>
            </section>
        }

        @foreach (var question in group.Questions)
        {
            questionNumber++;
            <section class="question">
                <div class="question-head">
                    <span class="question-number">@questionNumber</span>
                    <p class="question-content">@Display.RichText(question.Content)</p>
                </div>

                <div class="option-list" role="radiogroup" aria-label="Đáp án câu @questionNumber">
                    @foreach (var option in question.Options)
                    {
                        <label class="option">
                            <input type="radio" name="Answers[@question.Id]" value="@option.Key" checked="@(Model.Answers.GetValueOrDefault(question.Id) == option.Key)" />
                            <span class="option-key">@(option.Label).</span>
                            <span>@Display.RichText(option.Text)</span>
                        </label>
                    }
                </div>
                @if (Model.IsPractice) { <a asp-page="/Learner/Save" asp-route-questionId="@question.Id" target="_blank" rel="noopener">Lưu câu / ghi chú</a> }
                @if (Model.IsPractice)
                {
                    @foreach (var correctOption in question.Options.Where(option => option.Key == question.CorrectOption))
                    {
                        <div class="explanation" data-answer-reveal hidden>
                            <strong>Đáp án đúng: @(correctOption.Label).</strong>
                            @Display.RichText(correctOption.Text)
                        </div>
                    }
                }
            </section>
        }
    }

    <p id="draft-status" role="status"></p><div class="mt-lg">
        <button type="submit" class="btn btn-accent btn-lg btn-block">Nộp bài</button>
        <p class="small muted mt-sm mb-0">Đáp án được lưu trên máy chủ khi có kết nối. Kiểm tra trạng thái lưu trước khi rời trang.</p>
    </div>
</form>
@if (Model.IsPractice)
{
    <p id="answer-visibility-status" class="visually-hidden" role="status" aria-live="polite"></p>
}

@section Scripts {
    <script src="~/js/learner-draft.js" asp-append-version="true" defer></script>
    @if (Model.IsPractice)
    {
        <script src="~/js/quiz-answers.js" asp-append-version="true" defer></script>
    }
    <script>
        (function () {
            var form = document.getElementById('quiz-form');
            var attemptId = form.dataset.attemptId;
            var total = parseInt(form.dataset.total, 10) || 0;
            var storageKey = 'quiz_attempt_' + attemptId;
            var saved = {};

            var radios = Array.prototype.slice.call(form.querySelectorAll('input[type="radio"]'));
            var progressBar = document.getElementById('progress-bar');
            var progressText = document.getElementById('progress-text');
            var progress = document.getElementById('progress');

            function questionIdOf(radio) {
                var match = radio.name.match(/(\d+)/);
                return match ? match[1] : '';
            }

            function updateProgress() {
                var answered = 0;
                var seen = {};
                radios.forEach(function (radio) {
                    var qid = questionIdOf(radio);
                    if (radio.checked) { seen[qid] = true; }
                });
                answered = Object.keys(seen).length;
                progressText.textContent = answered + '/' + total + ' câu';
                progress.setAttribute('aria-valuenow', String(answered));
                progressBar.style.width = total > 0 ? (answered * 100 / total) + '%' : '0%';
            }

            radios.forEach(function (radio) {
                var qid = questionIdOf(radio);
                if (saved[qid] === radio.value) {
                    radio.checked = true;
                }
                radio.addEventListener('change', function () {
                    if (!radio.checked) { return; }
                    saved[qid] = radio.value;
                    try { sessionStorage.setItem(storageKey, JSON.stringify(saved)); } catch (e) { }
                    updateProgress();
                });
            });

            updateProgress();

            form.addEventListener('submit', function () {
                try { sessionStorage.removeItem(storageKey); } catch (e) { }
            });

            var timer = document.getElementById('timer');
            if (timer) {
                var limitMinutes = parseInt(timer.dataset.limit, 10) || 0;
                var startedAt = new Date(form.dataset.startedAt).getTime();
                var timerText = document.getElementById('timer-text');
                var submitted = false;

                function tick() {
                    if (submitted) { return; }
                    var elapsed = (Date.now() - startedAt) / 1000;
                    var remaining = limitMinutes * 60 - elapsed;
                    if (remaining <= 0) {
                        submitted = true;
                        timerText.textContent = '00:00';
                        timer.classList.add('is-danger');
                        if (form.requestSubmit) { form.requestSubmit(); } else { form.submit(); }
                        return;
                    }
                    var seconds = Math.floor(remaining);
                    var minutes = Math.floor(seconds / 60);
                    var secs = seconds % 60;
                    timerText.textContent =
                        (minutes < 10 ? '0' : '') + minutes + ':' + (secs < 10 ? '0' : '') + secs;
                    timer.classList.toggle('is-warning', remaining <= 300);
                    timer.classList.toggle('is-danger', remaining <= 60);
                }

                tick();
                setInterval(tick, 1000);
            }
        })();
    </script>
}
