@page "{id:int}"
@model TracNghiemWeb.Pages.Test.TakeModel
@{
    ViewData["Title"] = "Làm bài";
    ViewData["Active"] = "subjects";
    var answered = Model.Questions.Count(q => q.SelectedOption is not null);
}

<div class="quiz-title"><h1>@Model.SubjectName</h1><p>Chọn một đáp án cho mỗi câu.</p></div>
<div class="quiz-bar">
    <div class="quiz-meta">
        <span class="badge badge-primary">@Model.SubjectName</span>
        @if (Model.TimeLimitMinutes is int limit)
        {
            <span class="timer" id="timer" data-limit="@limit">
                <svg class="icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 6v6l4 2" />
                </svg>
                <span id="timer-text">--:--</span>
            </span>
            <span class="visually-hidden">Thời gian còn lại</span>
        }
        else
        {
            <span class="small">Không giới hạn thời gian</span>
        }
    </div>

    <div class="quiz-meta">
        <span id="progress-text" aria-live="polite">@answered/@Model.Questions.Count câu</span>
        <button type="submit" form="quiz-form" asp-page="/Test/Take" asp-route-id="@Model.AttemptId" asp-page-handler="SaveAndExit" class="btn btn-quiet" id="leave-quiz">Lưu &amp; thoát</button>
        <button type="submit" form="quiz-form" class="btn btn-accent">Nộp bài</button>
    </div>

    <div class="progress" role="progressbar" aria-label="Tiến độ trả lời" aria-valuemin="0" aria-valuemax="@Model.Questions.Count" aria-valuenow="@answered" id="progress">
        <span id="progress-bar" style="width: @(Model.Questions.Count > 0 ? answered * 100 / Model.Questions.Count : 0)%"></span>
    </div>
    <p class="small muted mb-0" id="draft-status" role="status">@(Model.DraftSavedAt is DateTime saved ? $"Đã lưu trên máy chủ lúc {saved:HH:mm:ss}." : "Đáp án sẽ tự lưu trên máy chủ khi bạn chọn.")</p>
</div>

<form method="post" id="quiz-form"
      data-attempt-id="@Model.AttemptId"
      data-result-url="@Url.Page("/Test/Result", new { id = Model.AttemptId })"
      data-remaining-seconds="@Model.RemainingSeconds?.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-total="@Model.Questions.Count">
    <input type="hidden" name="id" value="@Model.AttemptId" />

    @{
        var questionNumber = 0;
    }
    @foreach (var group in Model.Groups)
    {
        if (group.Passage is not null)
        {
            <section class="passage-card">
                @if (!string.IsNullOrWhiteSpace(group.Passage.Title))
                {
                    <h2 class="passage-title">@group.Passage.Title</h2>
                }
                <div class="passage-content">@Display.RichText(group.Passage.Content)</div>
            </section>
        }

        @foreach (var question in group.Questions)
        {
            questionNumber++;
            <section class="question" id="question-@questionNumber" data-question-number="@questionNumber">
                <div class="question-head">
                    <span class="question-number">@questionNumber</span>
                    <p class="question-content">@Display.RichText(question.Content)</p>
                </div>

                <div class="option-list" role="radiogroup" aria-label="Đáp án câu @questionNumber">
                    @foreach (var option in question.Options)
                    {
                        <label class="option">
                            <input type="radio" name="Answers[@question.Id]" value="@option.Key" checked="@(question.SelectedOption == option.Key)" />
                            <span class="option-key">@(option.Label).</span>
                            <span>@Display.RichText(option.Text)</span>
                        </label>
                    }
                </div>
            </section>
        }
    }

    <div class="mt-lg">
        <button type="submit" class="btn btn-accent btn-lg btn-block">Nộp bài</button>
        <p class="small muted mt-sm mb-0">Bạn có thể rời trang sau khi thấy xác nhận đã lưu và tiếp tục bài từ trang tổng quan.</p>
        <noscript><p class="small">Tự lưu cần JavaScript. Bạn vẫn có thể chọn đáp án và nộp bài trực tiếp.</p></noscript>
    </div>
</form>

@section Scripts {
    <script src="~/js/quiz.js" asp-append-version="true" defer></script>
}
