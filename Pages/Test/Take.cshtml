@page "{id:int}"
@model TracNghiemWeb.Pages.Test.TakeModel
@{
    ViewData["Title"] = "Làm bài";
    ViewData["FocusMode"] = true;
    var answered = Model.Questions.Count(q => q.SelectedOption is not null);
    var total = Model.Questions.Count;
    var percentage = total == 0 ? 0 : answered * 100 / total;
    var seconds = (int)Math.Ceiling(Model.RemainingSeconds ?? 0);
}

<div class="page-head take-heading"><div><span class="eyebrow">BÀI LUYỆN TẬP #@Model.AttemptId</span><h1>@Model.SubjectName</h1><p>@total câu · @(Model.TimeLimitMinutes is int minutes ? $"{minutes} phút" : "Không giới hạn thời gian")</p></div></div>

<div class="quiz-bar" id="quiz-toolbar">
    <div class="quiz-progress-meta"><span class="small muted">Đã trả lời</span><strong id="progress-text" aria-live="polite">@answered/@total</strong></div>
    <div class="quiz-toolbar-actions">
        @if (Model.TimeLimitMinutes is not null)
        {
            <div class="timer" id="timer" role="timer" aria-label="Thời gian còn lại"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="13" r="8"/><path d="M12 8v5l3 2M9 2h6M12 2v3"/></svg><span id="timer-text">@((seconds / 60).ToString("00")):@((seconds % 60).ToString("00"))</span></div>
        }
        else
        {
            <span class="small muted free-time">Tự do</span>
        }
        <button type="submit" form="quiz-form" class="btn btn-accent">Nộp bài <span aria-hidden="true">→</span></button>
    </div>
    <div class="progress" role="progressbar" aria-label="Tiến độ trả lời" aria-valuemin="0" aria-valuemax="@total" aria-valuenow="@answered" id="progress"><span id="progress-bar" style="width: @(percentage)%"></span></div>
</div>

<div class="quiz-layout">
    <aside class="quiz-aside">
        <details class="card question-overview" open>
            <summary>Câu hỏi <span class="small muted">@total câu</span></summary>
            <nav class="question-jump" aria-label="Chuyển đến câu hỏi">
                @{ var navNumber = 0; }
                @foreach (var group in Model.Groups)
                {
                    @foreach (var question in group.Questions)
                    {
                        navNumber++;
                        <a href="#question-@question.Id" class="@(question.SelectedOption is not null ? "answered" : null)" data-question-number="@navNumber" data-question-id="@question.Id" aria-label="Câu @navNumber, @(question.SelectedOption is not null ? "đã trả lời" : "chưa trả lời")">@navNumber</a>
                    }
                }
            </nav>
            <div class="question-legend"><span><i class="legend-dot answered" aria-hidden="true"></i>Đã trả lời</span><span><i class="legend-dot" aria-hidden="true"></i>Còn trống</span></div>
            <button type="button" class="btn btn-secondary btn-sm btn-block" id="next-unanswered" data-enhanced hidden>Tìm câu còn trống</button>
        </details>
        <p id="draft-status" class="draft-status" role="status" aria-live="polite">@(Model.DraftSavedAt is not null ? $"Đã lưu {answered}/{total} trên máy chủ" : "Sẵn sàng làm bài")</p>
        <noscript><p class="small muted">Chọn “Lưu &amp; thoát” để lưu lựa chọn, hoặc “Nộp bài” để chấm điểm. Tự lưu và đồng hồ cần JavaScript; máy chủ vẫn kiểm tra thời hạn.</p></noscript>
    </aside>
    <form method="post" id="quiz-form" class="quiz-questions"
          data-attempt-id="@Model.AttemptId" data-total="@total"
          data-remaining-seconds="@(Model.RemainingSeconds?.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture))"
          data-result-url="@Url.Page("/Test/Result", new { id = Model.AttemptId })"
          data-home-url="@Url.Page("/Index")">
        <input type="hidden" name="id" value="@Model.AttemptId" />
        @{ var number = 0; }
        @foreach (var group in Model.Groups)
        {
            <div class="quiz-group">
                @if (group.Passage is not null)
                {
                    <section class="passage-card"><span class="eyebrow">BÀI ĐỌC · @group.Questions.Count CÂU</span><h2 class="passage-title">@(string.IsNullOrWhiteSpace(group.Passage.Title) ? "Đọc đoạn văn" : group.Passage.Title)</h2><div class="passage-content">@Display.RichText(group.Passage.Content)</div></section>
                }
                @foreach (var question in group.Questions)
                {
                    number++;
                    <section class="question" id="question-@question.Id" data-question-number="@number" data-question-id="@question.Id" tabindex="-1" aria-labelledby="question-title-@question.Id">
                        <div class="question-topline"><span class="question-count-label">Câu @number <span>/ @total</span></span><button type="button" class="clear-answer" data-clear-question="@question.Id" data-enhanced hidden>Bỏ chọn</button></div>
                        <h2 class="question-content" id="question-title-@question.Id">@Display.RichText(question.Content)</h2>
                        <div class="option-list" role="radiogroup" aria-labelledby="question-title-@question.Id">
                            @foreach (var option in question.Options)
                            {
                                <label class="option"><input type="radio" name="Answers[@question.Id]" value="@option.Key" checked="@(question.SelectedOption == option.Key)" /><span class="option-key">@option.Label</span><span class="option-text">@Display.RichText(option.Text)</span></label>
                            }
                        </div>
                    </section>
                }
            </div>
        }
        <div class="quiz-bottom"><span class="small muted">Bạn có thể xem lại các câu trước khi nộp.</span><button type="submit" class="btn btn-accent">Nộp bài <span aria-hidden="true">→</span></button></div>
    </form>
</div>

<dialog id="submit-dialog" class="submit-dialog" aria-labelledby="submit-title" aria-describedby="submit-description">
    <div class="dialog-mark" aria-hidden="true">?</div><h2 id="submit-title">Nộp bài luyện tập?</h2><p id="submit-description"></p><div class="dialog-actions"><button type="button" class="btn btn-secondary" id="cancel-submit">Làm tiếp</button><button type="button" class="btn btn-accent" id="confirm-submit">Nộp &amp; chấm điểm</button></div>
</dialog>
@section Scripts { <script src="~/js/quiz.js" asp-append-version="true" defer></script> }
