@page
@model TracNghiemWeb.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Register ? "Tạo tài khoản" : "Đăng nhập";
}
<section class="auth-shell">
    <aside class="auth-intro"><span class="badge">TRẮC NGHIỆM</span><h1>Học từng chút.<br>Tiến bộ mỗi ngày.</h1><p>Một nơi để luyện tập, xem lại câu sai và tiếp tục hành trình học của bạn.</p></aside>
    <div class="auth-form"><h2>@ViewData["Title"]</h2><p>Chào bạn, cùng bắt đầu buổi luyện tập.</p>
    <form method="post" data-auth-form>
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <label asp-for="Email">Email</label><input class="input" asp-for="Email" type="email" autocomplete="username" aria-describedby="email-error" required /><span asp-validation-for="Email" id="email-error" class="text-danger"></span>
        <label asp-for="Password">Mật khẩu</label><input class="input" id="Password" name="Password" type="password" autocomplete="@(Model.Register ? "new-password" : "current-password")" aria-describedby="password-error" minlength="8" maxlength="128" required />
        <span asp-validation-for="Password" id="password-error" class="text-danger"></span>
        <button type="button" class="btn btn-secondary" data-password-toggle aria-controls="Password" aria-pressed="false">Hiện mật khẩu</button>
        @if (Model.Register) { <p class="small">Từ 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</p> }
        else { <label><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label> }
        <button class="btn btn-primary btn-block" type="submit" data-auth-submit>@ViewData["Title"]</button>
        <span class="visually-hidden" role="status" data-auth-status></span>
        @if (Model.ShowTestAccount)
        {
            <p class="small mt-md mb-0">
                Email: <span data-test-email>@Model.TestEmail</span><br />
                Mật khẩu: <span data-test-password style="overflow-wrap: anywhere">@Model.TestPassword</span>
            </p>
        }
    </form>
    <p class="mt-lg"><a asp-page="/Account/Login" asp-route-mode="@(Model.Register ? null : "register")">@(Model.Register ? "Đã có tài khoản? Đăng nhập" : "Chưa có tài khoản? Đăng ký")</a></p></div>
</section>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true" defer></script>
}
