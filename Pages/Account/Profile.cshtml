@page
@model TracNghiemWeb.Pages.Account.ProfileModel
@{ ViewData["Title"] = "Tài khoản"; ViewData["Active"] = "profile"; }
<div class="page-head"><div><span class="eyebrow">THÔNG TIN CÁ NHÂN</span><h1>Tài khoản</h1></div></div>
<div class="profile-layout">
    <section class="card profile-summary"><span class="profile-avatar" aria-hidden="true">@Display.Initial(Model.Input.DisplayName)</span><h2>@Model.Input.DisplayName</h2><p class="muted">@Model.Email</p><span class="badge @(User.IsInRole("Admin") ? "badge-accent" : "badge-primary")">@(User.IsInRole("Admin") ? "Admin" : "User")</span></section>
    <form method="post" class="card form-grid" data-busy="Đang lưu…">
        <h2 class="mb-0">Thông tin tài khoản</h2><div asp-validation-summary="ModelOnly" role="alert"></div>
        <div class="field"><label asp-for="Input.DisplayName">Tên hiển thị</label><input asp-for="Input.DisplayName" class="input" autocomplete="name" maxlength="80" required /><span asp-validation-for="Input.DisplayName" class="field-error"></span></div>
        <details class="account-password" open="@(!ViewData.ModelState.IsValid)"><summary>Đổi mật khẩu</summary><div class="form-grid mt-md">
            <div class="field"><label asp-for="Input.CurrentPassword">Mật khẩu hiện tại</label><input asp-for="Input.CurrentPassword" class="input" autocomplete="current-password" /><span asp-validation-for="Input.CurrentPassword" class="field-error"></span></div>
            <div class="field"><label asp-for="Input.NewPassword">Mật khẩu mới</label><input asp-for="Input.NewPassword" class="input" autocomplete="new-password" aria-describedby="new-password-help" /><span class="hint" id="new-password-help">Từ 10 ký tự, có chữ hoa, chữ thường và số.</span><span asp-validation-for="Input.NewPassword" class="field-error"></span></div>
            <div class="field"><label asp-for="Input.ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="field-error"></span></div>
        </div></details>
        <div class="form-actions"><a class="btn btn-ghost" asp-page="/Index">Về luyện tập</a><button type="submit" class="btn btn-primary">Lưu thay đổi</button></div>
    </form>
</div>
