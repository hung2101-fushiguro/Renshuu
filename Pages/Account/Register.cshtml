@page
@model TracNghiemWeb.Pages.Account.RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng ký";
}

<section class="auth-intro">
    <h1>Tạo không gian luyện tập của riêng bạn.</h1>
    <p>Đăng ký miễn phí để lưu thư mục, môn học và toàn bộ lịch sử làm bài theo tài khoản của bạn.</p>
    <ul class="auth-points">
        <li>Nội dung bạn tạo luôn riêng tư; chỉ chia sẻ khi bạn chủ động công khai.</li>
        <li>Tiến độ và câu sai được lưu riêng cho từng tài khoản.</li>
    </ul>
</section>

<section class="auth-panel">
    <h2>Tạo tài khoản</h2>
    <p class="muted">Chỉ mất một phút. Bạn có thể đổi cách học bất cứ lúc nào.</p>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="field">
            <label asp-for="DisplayName">Tên hiển thị</label>
            <input asp-for="DisplayName" class="input" type="text" autocomplete="nickname"
                   maxlength="120" aria-describedby="display-name-error" />
            <span asp-validation-for="DisplayName" id="display-name-error" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="input" type="email" autocomplete="username"
                   inputmode="email" maxlength="256" aria-describedby="email-error" required />
            <span asp-validation-for="Email" id="email-error" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Password">Mật khẩu</label>
            <div class="password-field">
                <input asp-for="Password" id="Password" class="input" type="password"
                       autocomplete="new-password" aria-describedby="password-hint password-error"
                       minlength="8" maxlength="128" required />
                <button type="button" class="password-toggle" data-password-toggle
                        aria-controls="Password" aria-pressed="false">Hiện</button>
            </div>
            <span class="hint" id="password-hint">Từ 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.</span>
            <span asp-validation-for="Password" id="password-error" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
            <input asp-for="ConfirmPassword" id="ConfirmPassword" class="input" type="password"
                   autocomplete="new-password" aria-describedby="confirm-password-error"
                   minlength="8" maxlength="128" required />
            <span asp-validation-for="ConfirmPassword" id="confirm-password-error" class="field-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block" data-auth-submit
                data-auth-busy="Đang tạo tài khoản…">Đăng ký</button>
        <span class="visually-hidden" role="status" data-auth-status></span>
    </form>

    <p class="auth-footnote muted">Đã có tài khoản? <a asp-page="/Account/Login">Đăng nhập</a>.</p>
</section>

@section Scripts {
    <script src="~/js/auth.js" asp-append-version="true" defer></script>
}
