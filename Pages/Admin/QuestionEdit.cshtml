@page
@model TracNghiemWeb.Pages.Admin.QuestionEditModel
@{
    ViewData["Title"] = Model.IsNew ? "Thêm câu hỏi" : "Sửa câu hỏi";
    ViewData["Active"] = "admin";
    ViewData["AdminTab"] = "questions";
}

<div class="page-head">
    <div>
        <h1>@(Model.IsNew ? "Thêm câu hỏi" : "Sửa câu hỏi")</h1>
        <p>Đáp án đúng được chấm điểm ở phía máy chủ.</p>
    </div>
    <div class="actions">
        <a class="btn btn-ghost" asp-page="/Admin/Questions" asp-route-subjectId="@Model.Input.SubjectId">Về danh sách</a>
    </div>
</div>

<partial name="_AdminNav" />

<form method="post" class="card">
    <div asp-validation-summary="All"></div>
    <input type="hidden" asp-for="Input.Id" />

    <div class="form-grid">
        <div class="field">
            <label asp-for="Input.SubjectId">Môn học</label>
            <select asp-for="Input.SubjectId" class="input">
                @foreach (var subject in Model.Subjects)
                {
                    <option value="@subject.Id">@subject.Name</option>
                }
            </select>
            <span asp-validation-for="Input.SubjectId" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Content">Nội dung câu hỏi</label>
            <textarea asp-for="Input.Content" class="input" rows="3" maxlength="2000"></textarea>
            <span asp-validation-for="Input.Content" class="field-error"></span>
        </div>

        <div class="form-row-2">
            <div class="field">
                <label asp-for="Input.OptionA">Đáp án A</label>
                <input asp-for="Input.OptionA" class="input" maxlength="500" />
                <span asp-validation-for="Input.OptionA" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.OptionB">Đáp án B</label>
                <input asp-for="Input.OptionB" class="input" maxlength="500" />
                <span asp-validation-for="Input.OptionB" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.OptionC">Đáp án C</label>
                <input asp-for="Input.OptionC" class="input" maxlength="500" />
                <span asp-validation-for="Input.OptionC" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.OptionD">Đáp án D</label>
                <input asp-for="Input.OptionD" class="input" maxlength="500" />
                <span asp-validation-for="Input.OptionD" class="field-error"></span>
            </div>
        </div>

        <div class="form-row-2">
            <div class="field">
                <label asp-for="Input.CorrectOption">Đáp án đúng</label>
                <select asp-for="Input.CorrectOption" class="input">
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="C">C</option>
                    <option value="D">D</option>
                </select>
                <span asp-validation-for="Input.CorrectOption" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.OptionStyle">Kiểu đánh số đáp án</label>
                <select asp-for="Input.OptionStyle" class="input">
                    <option value="ABCD">A, B, C, D</option>
                    <option value="1234">1, 2, 3, 4</option>
                </select>
                <span class="hint">Với kiểu 1–4: A = 1, B = 2, C = 3, D = 4.</span>
                <span asp-validation-for="Input.OptionStyle" class="field-error"></span>
            </div>
        </div>

        <div class="field">
            <label asp-for="Input.Explanation">Giải thích (không bắt buộc)</label>
            <input asp-for="Input.Explanation" class="input" maxlength="2000" />
            <span asp-validation-for="Input.Explanation" class="field-error"></span>
        </div>

        <fieldset class="field">
            <legend>Phân loại kiến thức</legend>
            <div class="form-row-2">
                <div class="field"><label asp-for="Input.Chapter">Chương</label><input asp-for="Input.Chapter" class="input" maxlength="100" /><span asp-validation-for="Input.Chapter" class="field-error"></span></div>
                <div class="field"><label asp-for="Input.Topic">Chủ đề</label><input asp-for="Input.Topic" class="input" maxlength="100" /><span asp-validation-for="Input.Topic" class="field-error"></span></div>
            </div>
            <label asp-for="Input.Difficulty">Độ khó dự kiến</label>
            <select asp-for="Input.Difficulty" class="input"><option value="">Chưa phân loại</option><option value="Easy">Dễ</option><option value="Medium">Trung bình</option><option value="Hard">Khó</option></select>
            <span asp-validation-for="Input.Difficulty" class="field-error"></span>
            <p class="hint">AI đề xuất dựa trên nội dung; bạn có thể chỉnh sửa trước khi lưu.</p>
            <button type="button" id="analyze-question" class="btn btn-secondary">AI đề xuất phân loại</button>
            <p id="analysis-status" role="status" aria-live="polite"></p>
            <div id="analysis-preview" hidden>
                <strong id="analysis-summary"></strong><p id="analysis-reason"></p>
                <button type="button" id="apply-analysis" class="btn btn-secondary">Áp dụng đề xuất</button>
            </div>
        </fieldset>
        <div class="page-head actions mt-0">
            <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Thêm câu hỏi" : "Lưu thay đổi")</button>
            <a class="btn btn-ghost" asp-page="/Admin/Questions" asp-route-subjectId="@Model.Input.SubjectId">Hủy</a>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/question-analysis.js" asp-append-version="true"></script>
}
