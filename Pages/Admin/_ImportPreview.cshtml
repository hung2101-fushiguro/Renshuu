@model TracNghiemWeb.Services.ImportPreview

<div data-import-preview>
<div class="toolbar preview-toolbar" hidden data-preview-controls>
    <div class="field"><label>Trạng thái dòng<select class="input" data-preview-filter><option value="all">Tất cả (@Model.Items.Count)</option><option value="valid">Hợp lệ (@Model.ValidCount)</option><option value="duplicate">Trùng (@Model.DuplicateCount)</option><option value="invalid">Lỗi (@Model.InvalidCount)</option></select></label></div>
    <p class="small muted mb-0" data-preview-count role="status"></p>
</div>
<p class="small muted preview-scroll-hint">Cuộn ngang bảng để xem đủ nội dung và chi tiết lỗi trên màn hình nhỏ.</p>
<div class="table-wrap mb-lg" tabindex="0" role="region" aria-label="Danh sách câu hỏi xem trước, có thể cuộn ngang">
    <table class="table preview-table">
        <thead>
            <tr>
                <th scope="col">#</th>
                <th scope="col">Môn</th>
                <th scope="col">Nội dung</th>
                <th scope="col">Đáp án</th>
                <th scope="col">Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                var isDuplicate = item.IsValid && Model.Duplicates.Contains(item.Index);
                <tr class="@(item.IsValid ? null : "row-invalid")" data-preview-status="@(!item.IsValid ? "invalid" : isDuplicate ? "duplicate" : "valid")">
                    <td class="nowrap">@item.Index</td>
                    <td>@item.Subject</td>
                    <td>
                        @Display.RichText(item.Content is null
                            ? ""
                            : item.Content.Length > 140 ? item.Content[..140] + "…" : item.Content)
                    </td>
                    <td class="nowrap">@Display.OptionLabel(item.OptionStyle, item.Correct ?? "")</td>
                    <td>
                        @if (!item.IsValid)
                        {
                            <span class="badge badge-danger">Lỗi</span>
                            <ul class="preview-errors">
                                @foreach (var error in item.Errors)
                                {
                                    <li>@error</li>
                                }
                            </ul>
                        }
                        else if (isDuplicate)
                        {
                            <span class="badge badge-accent">Trùng – sẽ bỏ qua</span>
                        }
                        else
                        {
                            <span class="badge badge-success">Hợp lệ</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="empty" data-preview-empty hidden>Không có dòng nào thuộc trạng thái này.</p>

<p class="muted">
    Hợp lệ: <strong>@Model.ValidCount</strong> ·
    Trùng (bỏ qua): <strong>@Model.DuplicateCount</strong> ·
    Lỗi (bỏ qua): <strong>@Model.InvalidCount</strong>
</p>
</div>
