@page
@model TracNghiemWeb.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Quản trị môn học";
    ViewData["Active"] = "admin";
    ViewData["AdminTab"] = "subjects";
}

<div class="page-head">
    <div>
        <h1>Quản trị</h1>
    </div>
</div>

<partial name="_AdminNav" />

<div class="grid grid-admin-forms mb-lg">
    <div class="card">
        <h2 class="mt-0">Thêm thư mục</h2>
        <p class="muted">Thư mục giúp gom các môn cùng bộ, ví dụ JLPT N3 hoặc PRN222.</p>
        <form method="post" asp-page-handler="CreateFolder" class="toolbar mb-0">
            <div class="field">
                <label asp-for="NewFolderName">Tên thư mục</label>
                <input asp-for="NewFolderName" class="input" maxlength="200" placeholder="Ví dụ: JLPT N3" />
                <span asp-validation-for="NewFolderName" class="field-error"></span>
            </div>
            <button type="submit" class="btn btn-primary">Thêm thư mục</button>
        </form>
    </div>

    <div class="card">
        <h2 class="mt-0">Thêm môn học</h2>
        <form method="post" asp-page-handler="Create">
            <div class="form-grid">
                <div class="field">
                    <label asp-for="NewSubjectName">Tên môn học</label>
                    <input asp-for="NewSubjectName" class="input" maxlength="200" />
                    <span asp-validation-for="NewSubjectName" class="field-error"></span>
                </div>
                <div class="form-row-2">
                    <div class="field">
                        <label asp-for="NewSubjectFolderId">Thư mục</label>
                        <select asp-for="NewSubjectFolderId" class="input">
                            <option value="">— Không thuộc thư mục —</option>
                            @foreach (var folder in Model.Folders)
                            {
                                <option value="@folder.Id">@folder.Name</option>
                            }
                        </select>
                        <span asp-validation-for="NewSubjectFolderId" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="NewSubjectNewFolderName">Hoặc tạo thư mục mới</label>
                        <input asp-for="NewSubjectNewFolderName" class="input" maxlength="200"
                               placeholder="Nhập tên thư mục mới" />
                        <span class="hint">Nếu nhập, thư mục mới sẽ được tạo và môn này được xếp vào đó.</span>
                        <span asp-validation-for="NewSubjectNewFolderName" class="field-error"></span>
                    </div>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary">Thêm môn</button>
                </div>
            </div>
        </form>
    </div>
</div>

<h2>Thư mục</h2>

@if (Model.Folders.Count == 0)
{
    <div class="empty mb-lg">
        <strong>Chưa có thư mục nào.</strong>
        <p class="mt-sm">Tạo thư mục ở khung phía trên, sau đó gán môn học vào thư mục.</p>
    </div>
}
else
{
    <div class="table-wrap mb-lg">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Thư mục</th>
                    <th scope="col" class="num">Số môn</th>
                    <th scope="col">Đổi tên</th>
                    <th scope="col"><span class="visually-hidden">Hành động</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var folder in Model.Folders)
                {
                    <tr>
                        <td>@folder.Name</td>
                        <td class="num">@folder.SubjectCount</td>
                        <td>
                            <form method="post" asp-page-handler="RenameFolder" class="toolbar mb-0">
                                <input type="hidden" name="id" value="@folder.Id" />
                                <input type="text" name="name" value="@folder.Name" class="input" maxlength="200"
                                       aria-label="Tên mới cho thư mục @folder.Name" />
                                <button type="submit" class="btn btn-secondary btn-sm">Lưu</button>
                            </form>
                        </td>
                        <td class="num">
                            <form method="post" asp-page-handler="DeleteFolder" class="inline-form"
                                  onsubmit="return confirm('Xóa thư mục &quot;@folder.Name&quot;? Các môn bên trong sẽ được chuyển ra ngoài.');">
                                <input type="hidden" name="id" value="@folder.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2>Danh sách môn học</h2>

@if (Model.Subjects.Count == 0)
{
    <div class="empty">
        <strong>Chưa có môn học nào.</strong>
        <p class="mt-sm">Thêm môn học ở khung phía trên để bắt đầu.</p>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">Môn học</th>
                    <th scope="col">Thư mục</th>
                    <th scope="col" class="num">Số câu</th>
                    <th scope="col" class="num">Lượt làm</th>
                    <th scope="col">Đổi tên / thư mục</th>
                    <th scope="col"><span class="visually-hidden">Hành động</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in Model.Subjects)
                {
                    <tr>
                        <td>@subject.Name</td>
                        <td>
                            @if (subject.FolderName is not null)
                            {
                                <span class="badge badge-muted">@subject.FolderName</span>
                            }
                            else
                            {
                                <span class="muted">—</span>
                            }
                        </td>
                        <td class="num">
                            <a asp-page="/Admin/Questions" asp-route-subjectId="@subject.Id">@subject.QuestionCount</a>
                        </td>
                        <td class="num">@subject.AttemptCount</td>
                        <td>
                            <form method="post" asp-page-handler="Rename" class="toolbar mb-0">
                                <input type="hidden" name="EditId" value="@subject.Id" />
                                <input type="text" name="EditName" value="@subject.Name" class="input" maxlength="200"
                                       aria-label="Tên mới cho môn @subject.Name" />
                                <select name="EditFolderId" class="input" aria-label="Thư mục cho môn @subject.Name">
                                    <option value="">— Không thư mục —</option>
                                    @foreach (var folder in Model.Folders)
                                    {
                                        <option value="@folder.Id" selected="@(folder.Id == subject.FolderId)">@folder.Name</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-secondary btn-sm">Lưu</button>
                            </form>
                        </td>
                        <td class="num">
                            <form method="post" asp-page-handler="Delete" class="inline-form"
                                  onsubmit="return confirm('Xóa môn &quot;@subject.Name&quot; và toàn bộ câu hỏi của môn này?');">
                                <input type="hidden" name="id" value="@subject.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
